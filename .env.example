# ===========================================================================
# تنظیمات محیطی فروشگاه آوای انعکاس
# ===========================================================================

# هسته جنگو
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-random-long-key-123456789
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
TIME_ZONE=Asia/Tehran

# فرانت و CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# پایگاه داده (پیش‌فرض: sqlite | گزینه‌ها: sqlite, postgresql)
DB_ENGINE=sqlite
DB_TIMEOUT=20
# در صورت انتخاب postgresql:
# DB_NAME=ava_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432

# احراز هویت پیامکی (OTP)
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_EXPOSE_DEV_CODE=True

# توکن‌های JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# تنظیمات صفحه‌بندی
PAGE_SIZE=20
